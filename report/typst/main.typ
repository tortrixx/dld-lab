    [#m("piece_rom")], [#m("S5") 图案与随机数据], [零片形状查找表（相对掩码、包围盒宽高与块数）], [否],
    [#m("rng_lfsr")], [#m("S5") 图案与随机数据], [8 位伪随机数发生器，序列周期 255], [是],
    [#m("disp_format")], [#m("S6") 显示子系统], [显示总入口：状态映射为 8 位 BCD、熄灭掩码与点阵像素多路选择], [否],
    [#m("seg_scan")], [#m("S6") 显示子系统], [8 位数码管动态扫描与 BCD 译码], [是],
    [#m("dot_matrix_scan")], [#m("S6") 显示子系统], [8×8 双色点阵动态扫描，含消隐防鬼影], [是],
